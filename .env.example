# ─────────────────────────────────────────────────────────────────────────────
# Cloud Audit — Environment Configuration Template (.env.example)
#
# Instructions:
# 1. Copy this file to create your local .env:
#      cp .env.example .env
# 2. Fill in real values or customize for your environment.
# 3. NEVER commit the .env file to Git — it is gitignored to protect secrets.
# ─────────────────────────────────────────────────────────────────────────────

# -----------------------------------------------------------------------------
# AWS / LocalStack Authentication & Configuration
# -----------------------------------------------------------------------------
# For LocalStack testing, "test"/"test" are the default dummy credentials:
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_DEFAULT_REGION=us-east-1

# LocalStack custom endpoint (comment out or leave empty when auditing real AWS):
AWS_ENDPOINT_URL=http://localhost:4566

# Optional: LocalStack Hobby/Pro Auth Token (if using advanced LocalStack features)
# LOCALSTACK_AUTH_TOKEN=your_localstack_token_here

# -----------------------------------------------------------------------------
# Alerting & Webhooks (Discord / Slack)
# -----------------------------------------------------------------------------
# Webhook URL for automated audit scan notifications (discord_alert.py)
# Format for Discord: https://discord.com/api/webhooks/<WEBHOOK_ID>/<WEBHOOK_TOKEN>
WEBHOOK_URL=
# DISCORD_WEBHOOK_URL=

# -----------------------------------------------------------------------------
# Pipeline Audit Defaults (Subject Mandatory Arguments)
# -----------------------------------------------------------------------------
# target_environment: e.g. "default", "sandbox-01", "production"
TARGET_ENVIRONMENT=sandbox-01

# compliance_framework: Supported standards (e.g. "cis")
COMPLIANCE_FRAMEWORK=cis

# severity_filter: Minimum severity threshold ("CRITICAL", "HIGH", "MEDIUM", "LOW")
SEVERITY_FILTER=CRITICAL

# output_format: Report format ("html", "csv")
OUTPUT_FORMAT=html
