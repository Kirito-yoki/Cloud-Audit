# ==============================================================================
# Cloud Audit - .gitignore
# Tailored for Python, Prowler CSPM, LocalStack, Terraform, and CIS Audit Scans
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Environment Variables & Secrets (CRITICAL - Never commit secrets)
# ------------------------------------------------------------------------------
.env
.env.*
!.env.example
credentials.json
aws_credentials*
.aws/
*.pem
*.key
*.crt
*.pfx
*.p12
secrets.json

# ------------------------------------------------------------------------------
# 2. CSPM Scan Artifacts & Generated Reports
# ------------------------------------------------------------------------------
# Prowler raw execution output directory
output/

# Timestamped audit directories created by organize_output.py (e.g., audit_2026-...)
audit_*/

# Reports directory generated by the audit pipeline
reports/

# Individual report & scan data formats generated during audits
custom_report.html
*.asff.json
*.html
*.csv

# ------------------------------------------------------------------------------
# 3. Python & Virtual Environments
# ------------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# Environments
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/

# Packaging & Builds
*.egg-info/
*.egg
build/
dist/
develop-eggs/
downloads/
eggs/
.eggs/
parts/
sdist/
var/
wheels/

# Testing & Tooling caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
.tox/
.nox/

# ------------------------------------------------------------------------------
# 4. Logs & Runtime Output
# ------------------------------------------------------------------------------
*.log
cloud-audit.log

# ------------------------------------------------------------------------------
# 5. LocalStack & Container Artifacts
# ------------------------------------------------------------------------------
.localstack/
localstack_data/

# ------------------------------------------------------------------------------
# 6. Terraform (Referenced in remediation playbooks)
# ------------------------------------------------------------------------------
.terraform/
*.tfstate
*.tfstate.*
crash.log
*.tfvars
*.tfvars.json
override.tf
override.tf.json
*_override.tf
*_override.tf.json
.terraformrc
terraform.rc

# ------------------------------------------------------------------------------
# 7. Student Reports & Non-code Deliverables
# ------------------------------------------------------------------------------
*.pdf
Rapport_*.pdf

# ------------------------------------------------------------------------------
# 8. Personal Notes & Errant Shell Artifacts
# ------------------------------------------------------------------------------
.agent.md
resumee.md
python3

# ------------------------------------------------------------------------------
# 9. Operating System & IDE Artifacts
# ------------------------------------------------------------------------------
# macOS
.DS_Store
.DS_Store?
._*
.AppleDouble
.LSOverride

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# Linux / Vim / Editors
*~
*.swp
*.swo
*.swn
.directory
.idea/
.vscode/
